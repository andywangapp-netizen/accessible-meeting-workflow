# Copy to .env in this directory. Never commit .env.
# All values are optional. The offline evaluator does not need them.

# Your own public Zoom Workflow / agent URL, if you have one.
# Leave empty to stay offline (generate + evaluate only).
# Do not put employer-only or non-public URLs here.
AMEVAL_PUBLIC_ENDPOINT=

# Optional bearer token for THAT public endpoint, if it requires one.
# Prefer browser login instead of a token. Never commit a real value.
AMEVAL_PUBLIC_TOKEN=

# Optional destination email for a local dry-run of the email delivery slot.
# Use an inbox you own. This project never sends mail unless you add that yourself.
AMEVAL_EMAIL_TO=
